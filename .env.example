# Copie ce fichier en ".env" pour le développement local (jamais commité).
# En production, ces valeurs se configurent dans Netlify → Project configuration
# → Environment variables. Ne mets jamais de vraie valeur dans ce fichier .example.

# Jeton secret de ton intégration interne Notion (notion.so/my-integrations).
NOTION_TOKEN=

# Identifiants de la base "CRM — Prospection Sites Web".
# Laisse-les vides au tout premier lancement : l'endpoint /api/admin/setup-notion
# les crée pour toi et te les affiche, à reporter ici ensuite.
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# ID de la page Notion vide sous laquelle la base sera créée par le setup
# (uniquement nécessaire pour l'appel de setup initial).
NOTION_PARENT_PAGE_ID=
